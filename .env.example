
# NEXT_PUBLIC_BASE_URL=https://webhaat.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
SANITY_API_TOKEN=
SANITY_API_READ_TOKEN=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk URL Configuration
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SSLCommerz (bKash, Nagad, Rocket, cards — Bangladesh). Leave empty to disable.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true


# Contact Information
NEXT_PUBLIC_COMPANY_NAME=WebHaat
NEXT_PUBLIC_COMPANY_EMAIL=support@webhaat.com
NEXT_PUBLIC_COMPANY_PHONE=+1 (555) 123-4567
NEXT_PUBLIC_COMPANY_ADDRESS=123 Shopping Street, Commerce District
NEXT_PUBLIC_COMPANY_CITY=New York, NY 10001, USA
NEXT_PUBLIC_COMPANY_BUSINESS_HOURS_WEEKDAY=Monday - Friday: 9AM - 6PM
NEXT_PUBLIC_COMPANY_BUSINESS_HOURS_WEEKEND=Saturday - Sunday: 10AM - 4PM
NEXT_PUBLIC_SUPPORT_EMAIL=support@webhaat.com
NEXT_PUBLIC_SALES_EMAIL=sales@webhaat.com
NEXT_PUBLIC_CONTACT_RESPONSE_TIME=We reply within 24 hours
NEXT_PUBLIC_QUICK_RESPONSE_TIME=2-4 hours during business hours

# Social Media Links (Optional)
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/webhaat
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/webhaat
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/webhaat
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/webhaat
NEXT_PUBLIC_YOUTUBE_URL=https://youtube.com/@webhaat
NEXT_PUBLIC_TWITTER_HANDLE=@webhaat

# Additional Settings
NEXT_PUBLIC_COMPANY_DESCRIPTION=Discover amazing products at WebHaat, your trusted online marketplace for quality items and exceptional customer service.
NEXT_PUBLIC_COPYRIGHT_TEXT=© 2026 WebHaat. All rights reserved.
# Legal/privacy contact shown on policy pages (fall back to NEXT_PUBLIC_SUPPORT_EMAIL)
NEXT_PUBLIC_LEGAL_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
# "Powered by WebHaat" credit in the footer (set to false to hide)
NEXT_PUBLIC_SHOW_POWERED_BY=true
NEXT_PUBLIC_POWERED_BY_URL=
NEXT_PUBLIC_PRIVACY_POLICY_URL=/privacy
NEXT_PUBLIC_TERMS_URL=/terms

# Admin setup — comma-separated admin emails (must match the user's VERIFIED Clerk email).
# Server-only: never sent to the browser.
ADMIN_EMAILS=admin@webhaat.com,owner@webhaat.com
# Legacy name, still read when ADMIN_EMAILS is empty. NEXT_PUBLIC_* values are embedded in the
# public JavaScript bundle (anyone can read them) — move the list to ADMIN_EMAILS and leave this empty.
NEXT_PUBLIC_ADMIN_EMAIL=
# Store / pricing
NEXT_PUBLIC_CURRENCY=USD
NEXT_PUBLIC_LOCALE=en-US
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=100
NEXT_PUBLIC_SHIPPING_FEE=10
NEXT_PUBLIC_TAX_RATE=0
NEXT_PUBLIC_BUSINESS_DISCOUNT_RATE=0.02

# Reward Points Configuration
REWARD_POINTS_THRESHOLD=3000
REWARD_POINTS_AMOUNT=5

# Loyalty Points Configuration  
LOYALTY_POINTS_ORDER_THRESHOLD=5
LOYALTY_POINTS_AMOUNT=100


# Email: use ANY SMTP provider (recommended: Brevo, Mailgun, SES, Zoho, your host)…
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# …or Gmail with OAuth2 (used when SMTP_HOST is empty)
# Email Service Configuration (Gmail OAuth2)
# Google OAuth for Email (Legacy naming - kept for compatibility)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Get refresh token from: https://developers.google.com/oauthplayground
GOOGLE_REFRESH_TOKEN=
# "From" address for all store emails
SENDER_EMAIL_ADDRESS=

# Node Environment

# Run webhook listener locally using the command below:
# stripe listen --forward-to localhost:3000/api/webhook
# Optional: Google AdSense publisher ID (ads disabled when empty)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# Optional: Google Search Console verification code
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Encrypts payment gateway credentials saved from Admin → Payments (long random string).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PAYMENT_ENCRYPTION_KEY=

# Signs newsletter unsubscribe links (falls back to PAYMENT_ENCRYPTION_KEY when empty)
UNSUBSCRIBE_SECRET=

# Optional: shared rate limiting across all server instances (Upstash Redis → your database →
# REST API). When empty, each server instance counts requests in memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Cloudflare Turnstile bot check on the contact and newsletter forms
# (dash.cloudflare.com → Turnstile → add site). Enabled only when BOTH are set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
